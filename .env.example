# Project-local env. Copy to .env and fill in. .env is gitignored.
#
# Only needed for a FiftyOne Enterprise (FOE) deployment. Running against
# local OSS FiftyOne needs none of this -- skip the .env entirely.

FIFTYONE_API_URI=
FIFTYONE_API_KEY=
FIFTYONE_PYPI_TOKEN=       # token for your org's private FOE package index

# Pin the FOE release your deployment runs (drives the SDK install).
FIFTYONE_VERSION=
